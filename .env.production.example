# ==============================================================================
# VIT Carpool Production Environment Configuration Template
# AWS ap-south-1 (Mumbai) Deployment
# ==============================================================================
# IMPORTANT:
# - NEVER commit real credentials or production secret keys to version control.
# - Store production values in AWS SSM Parameter Store (SecureString).
# - This template defines all required production variables validated by Zod
#   in apps/api/src/config/env.validation.ts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Domain and reverse proxy settings
# Replace yourdomain.com with your actual verified apex domain
APP_DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# Allowed CORS origins (comma-separated for apex and subdomains)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Express Trust Proxy Configuration
# Behind Caddy (which validates Cloudflare edge IPs and sets validated client_ip),
# setting TRUST_PROXY=1 trusts Caddy as the single upstream proxy hop.
# Alternatively, specify subnets: 'loopback,linklocal,uniquelocal,172.16.0.0/12'
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. Database (AWS RDS PostgreSQL 16 + PostGIS)
# ------------------------------------------------------------------------------
# Connection string requirements:
# - sslmode=require (enforces encrypted transit to RDS)
# - connection_limit=15 (MANDATORY on db.t4g.micro/small to prevent connection pool exhaustion)
# - connect_timeout=10
DATABASE_URL=postgresql://vit_carpool_user:CHANGE_ME_RDS_SECURE_PASSWORD@vit-carpool-prod-db.xxxxxxxxx.ap-south-1.rds.amazonaws.com:5432/vit_carpool_prod?schema=public&sslmode=require&connection_limit=15&connect_timeout=10

# ------------------------------------------------------------------------------
# 3. Custom RS256 JWT Authentication & OTP Security
# ------------------------------------------------------------------------------
# In production, custom RS256 asymmetric authentication is enforced.
# Generate matching 2048-bit RSA key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#
# Either store with literal \n escapes or base64-encode the PEM files:
#   base64 -w 0 private.pem (or base64 on macOS)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...EXAMPLE_BASE64_OR_ESCAPED_PEM...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA0...EXAMPLE_PEM...\n-----END PUBLIC KEY-----"
JWT_KEY_ID=vit-carpool-jwt-key-prod-1
JWT_ISSUER=https://api.yourdomain.com/auth/v1
JWT_AUDIENCE=authenticated
JWT_TEST_MODE=false

# Keyed HMAC Secret for OTP verification storage and replay prevention
# Must be at least 16 characters. Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
OTP_CLEANUP_INTERVAL_MS=1800000

# ------------------------------------------------------------------------------
# 4. Institutional Email Classification
# ------------------------------------------------------------------------------
ENABLE_AUTOMATIC_EMAIL_CLASSIFICATION=true
STUDENT_EMAIL_REGEX=^[a-zA-Z0-9._%+-]+@vitstudent\.ac\.in$
FACULTY_EMAIL_REGEX=^[a-zA-Z0-9._%+-]+@vit\.ac\.in$

# ------------------------------------------------------------------------------
# 5. Geocoding & Location Autocomplete (Mapbox)
# ------------------------------------------------------------------------------
# In production, LOCATION_PROVIDER cannot be 'mock'. It must be 'mapbox'.
LOCATION_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuLWtleSJ9.EXAMPLE_TOKEN
# Chennai and surrounding Tamil Nadu bounding box [minLon, minLat, maxLon, maxLat]
MAPBOX_SEARCH_BBOX=79.80,12.60,80.35,13.35
# VIT Chennai campus center proximity bias [lon, lat]
MAPBOX_PROXIMITY=80.1534,12.8406
LOCATION_REQUEST_TIMEOUT_MS=5000
LOCATION_RATE_LIMIT_TTL=60
LOCATION_RATE_LIMIT_LIMIT=30

# ------------------------------------------------------------------------------
# 6. Document & Image Storage (AWS S3 Private Bucket)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=vit-carpool-prod-uploads-ap-south-1-REPLACE_WITH_ACCOUNT_ID
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_EXPIRES_IN_SECONDS=900

# AWS IAM credentials (required if EC2 does not use an attached IAM Instance Profile)
# Best Practice: Assign an EC2 IAM Instance Profile with S3 PutObject/GetObject permissions.
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY

# ------------------------------------------------------------------------------
# 7. Transactional Email (AWS SES via SMTP)
# ------------------------------------------------------------------------------
# AWS SES SMTP endpoint for Mumbai (ap-south-1)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=465
SMTP_SECURE=true

# SES SMTP credentials (generated in AWS SES Console -> SMTP Settings)
SMTP_USER=CHANGE_ME_SES_SMTP_USERNAME
SMTP_PASS=CHANGE_ME_SES_SMTP_PASSWORD

# Sender identity must match a verified email address or domain in SES
SMTP_FROM="VIT Carpool <noreply@yourdomain.com>"

# ------------------------------------------------------------------------------
# 8. Rate Limiting & Abuse Prevention
# ------------------------------------------------------------------------------
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_LIMIT=10

# ------------------------------------------------------------------------------
# 9. Scheduled Commute Matching Engine
# ------------------------------------------------------------------------------
RECURRING_COMMUTE_INTERVAL_MS=3600000
RECURRING_COMMUTE_HORIZON_DAYS=14
