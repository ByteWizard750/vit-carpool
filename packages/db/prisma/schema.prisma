datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  extensions        = [postgis, uuidOssp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  output          = "./client"
  previewFeatures = ["postgresqlExtensions"]
}

// -----------------------------------------------------------------------------
// Milestone 1 Foundation Model
// -----------------------------------------------------------------------------

model SystemHealthRecord {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  service   String   @db.VarChar(64)
  status    String   @db.VarChar(32)
  details   Json?
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("system_health_records")
}

// -----------------------------------------------------------------------------
// Milestone 2 Identity, Verification & Audit Models
// -----------------------------------------------------------------------------

enum Audience {
  STUDENT
  FACULTY

  @@map("audience_type")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@map("verification_status_type")
}

enum VerificationMethod {
  AUTOMATIC_EMAIL
  MANUAL_ID_REVIEW
  ADMIN_OVERRIDE

  @@map("verification_method_type")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role_type")
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("verification_request_status_type")
}

model User {
  id                 String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  authUserId         String              @unique @map("auth_user_id") @db.Uuid
  email              String              @unique @db.VarChar(255)
  audience           Audience?
  verificationStatus VerificationStatus  @default(PENDING) @map("verification_status")
  verificationMethod VerificationMethod? @map("verification_method")
  verifiedAt         DateTime?           @map("verified_at") @db.Timestamptz(6)
  authUpdatedAt      DateTime?           @map("auth_updated_at") @db.Timestamptz(6)
  role               UserRole            @default(USER)
  fullName           String              @map("full_name") @db.VarChar(255)
  phoneNumber        String?             @map("phone_number") @db.VarChar(32)
  isSuspended        Boolean             @default(false) @map("is_suspended")
  suspensionReason   String?             @map("suspension_reason") @db.VarChar(500)
  suspendedAt        DateTime?           @map("suspended_at") @db.Timestamptz(6)
  suspendedBy        String?             @map("suspended_by") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  suspendingAdmin             User?                 @relation("AdminSuspendedUsers", fields: [suspendedBy], references: [id], onDelete: SetNull)
  suspendedUsers              User[]                @relation("AdminSuspendedUsers")
  verificationRequests        VerificationRequest[] @relation("UserVerificationRequests")
  reviewedVerificationRequests VerificationRequest[] @relation("AdminReviewedRequests")
  vehicles                    Vehicle[]             @relation("UserVehicles")
  rides                       Ride[]                @relation("DriverRides")
  passengerBookings           Booking[]             @relation("PassengerBookings")
  driverBookings              Booking[]             @relation("DriverBookings")
  passengerConversations      Conversation[]        @relation("PassengerConversations")
  driverConversations         Conversation[]        @relation("DriverConversations")
  sentMessages                Message[]             @relation("SentMessages")
  passengerRatings            DriverRating[]        @relation("PassengerRatings")
  driverRatings               DriverRating[]        @relation("DriverRatings")
  recurringCommutes           RecurringCommute[]    @relation("DriverRecurringCommutes")
  rideAlerts                  RideAlert[]           @relation("UserRideAlerts")
  notifications               Notification[]        @relation("UserNotifications")
  idempotencyKeys             IdempotencyKey[]
  initiatedBlocks             Block[]               @relation("UserBlocksInitiated")
  receivedBlocks              Block[]               @relation("UserBlocksReceived")
  filedReports                Report[]              @relation("UserReportsFiled")
  receivedReports             Report[]              @relation("UserReportsReceived")
  reviewedReports             Report[]              @relation("AdminReviewedReports")

  @@unique([id, audience])
  @@map("users")
}


model VerificationRequest {
  id                     String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                 String                    @map("user_id") @db.Uuid
  requestedAudience      Audience                  @map("requested_audience")
  institutionalEmail     String                    @map("institutional_email") @db.VarChar(255)
  idCardDocumentPath     String?                   @map("id_card_document_path") @db.VarChar(1024)
  idCardDocumentPurgedAt DateTime?                 @map("id_card_document_purged_at") @db.Timestamptz(6)
  status                 VerificationRequestStatus @default(PENDING)
  reviewedBy             String?                   @map("reviewed_by") @db.Uuid
  reviewedAt             DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes            String?                   @map("review_notes") @db.Text
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User  @relation("UserVerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("AdminReviewedRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("verification_requests")
}

model AuditLog {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  actorRole  UserRole? @map("actor_role")
  action     String    @db.VarChar(100)
  targetType String    @map("target_type") @db.VarChar(100)
  targetId   String    @map("target_id") @db.Uuid
  changes    Json      @default("{}")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Milestone 3.1 Vehicle Model
// -----------------------------------------------------------------------------

model Vehicle {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  make               String    @db.VarChar(64)
  model              String    @db.VarChar(64)
  color              String    @db.VarChar(32)
  registrationNumber String    @map("registration_number") @db.VarChar(32)
  capacity           Int       @db.Integer
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  user               User               @relation("UserVehicles", fields: [userId], references: [id], onDelete: Restrict)
  rides              Ride[]             @relation("VehicleRides")
  recurringCommutes  RecurringCommute[] @relation("VehicleRecurringCommutes")

  @@unique([id, userId])
  @@index([userId])
  @@map("vehicles")
}

// -----------------------------------------------------------------------------
// Milestone 3.2 Ride Publishing & Management Models
// -----------------------------------------------------------------------------

enum RideStatus {
  SCHEDULED
  CANCELLED
  COMPLETED

  @@map("ride_status_type")
}

model Ride {
  id                 String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driverId           String     @map("driver_id") @db.Uuid
  vehicleId          String     @map("vehicle_id") @db.Uuid
  audience           Audience
  origin             String     @db.VarChar(128)
  originAddress      String?    @map("origin_address") @db.VarChar(255)
  originLatitude     Float?     @map("origin_latitude")
  originLongitude    Float?     @map("origin_longitude")
  originPlaceId      String?    @map("origin_place_id") @db.VarChar(128)
  destination        String     @db.VarChar(128)
  destinationAddress String?    @map("destination_address") @db.VarChar(255)
  destinationLatitude Float?    @map("destination_latitude")
  destinationLongitude Float?   @map("destination_longitude")
  destinationPlaceId String?    @map("destination_place_id") @db.VarChar(128)
  pickupDescription  String?    @map("pickup_description") @db.VarChar(255)
  dropoffDescription String?    @map("dropoff_description") @db.VarChar(255)
  departureTime      DateTime   @map("departure_time") @db.Timestamptz(6)
  availableSeats     Int        @map("available_seats") @db.Integer
  totalSeats          Int               @default(6) @map("total_seats") @db.Integer
  costPerSeat         Int?              @map("cost_per_seat") @db.Integer
  status              RideStatus        @default(SCHEDULED)
  recurringCommuteId  String?           @map("recurring_commute_id") @db.Uuid
  scheduledOccurrence DateTime?         @map("scheduled_occurrence") @db.Date
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  driver             User              @relation("DriverRides", fields: [driverId, audience], references: [id, audience], onDelete: Restrict)
  vehicle            Vehicle           @relation("VehicleRides", fields: [vehicleId, driverId], references: [id, userId], onDelete: Restrict)
  recurringCommute   RecurringCommute? @relation("RecurringCommuteRides", fields: [recurringCommuteId], references: [id], onDelete: SetNull)
  bookings           Booking[]         @relation("RideBookings")
  conversations      Conversation[]
  ratings            DriverRating[]
  notifications      Notification[]
  idempotencyKeys    IdempotencyKey[]
  reports            Report[]          @relation("ReportedRides")

  @@unique([id, audience])
  @@unique([id, driverId])
  @@unique([recurringCommuteId, scheduledOccurrence])
  @@index([driverId])
  @@index([vehicleId])
  @@index([recurringCommuteId])
  @@index([audience, status, departureTime])
  @@index([departureTime])
  @@map("rides")
}

// -----------------------------------------------------------------------------
// Milestone 4.2 Booking Requests & Seat Allocation Models
// -----------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED

  @@map("booking_status_type")
}

model Booking {
  id                 String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rideId             String        @map("ride_id") @db.Uuid
  passengerId        String        @map("passenger_id") @db.Uuid
  driverId           String        @map("driver_id") @db.Uuid
  audience           Audience
  requestedSeats     Int           @map("requested_seats") @db.Integer
  status             BookingStatus @default(PENDING)
  confirmedAt        DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  rejectedAt         DateTime?     @map("rejected_at") @db.Timestamptz(6)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(255)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ride         Ride          @relation("RideBookings", fields: [rideId, audience], references: [id, audience], onDelete: Restrict)
  passenger    User          @relation("PassengerBookings", fields: [passengerId, audience], references: [id, audience], onDelete: Restrict)
  driver       User          @relation("DriverBookings", fields: [driverId], references: [id], onDelete: Restrict)
  conversation Conversation?
  rating       DriverRating?
  notifications Notification[]
  reports      Report[]       @relation("ReportedBookings")

  @@index([rideId])
  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@index([audience, status])
  @@map("bookings")
}

// -----------------------------------------------------------------------------
// Milestone 7.1 Private Ride Chat Models
// -----------------------------------------------------------------------------

model Conversation {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId   String    @unique @map("booking_id") @db.Uuid
  rideId      String    @map("ride_id") @db.Uuid
  passengerId String    @map("passenger_id") @db.Uuid
  driverId    String    @map("driver_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ride        Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passenger   User      @relation("PassengerConversations", fields: [passengerId], references: [id], onDelete: Restrict)
  driver      User      @relation("DriverConversations", fields: [driverId], references: [id], onDelete: Restrict)
  messages    Message[]

  @@index([passengerId])
  @@index([driverId])
  @@index([rideId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  content        String       @db.VarChar(1000)
  readAt         DateTime?    @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  reports        Report[]     @relation("ReportedMessages")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// -----------------------------------------------------------------------------
// Milestone 7.2 Driver Ratings & Reviews Models
// -----------------------------------------------------------------------------

model DriverRating {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId   String   @unique @map("booking_id") @db.Uuid
  rideId      String   @map("ride_id") @db.Uuid
  passengerId String   @map("passenger_id") @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  rating      Int      @db.SmallInt
  review      String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Restrict)
  passenger   User     @relation("PassengerRatings", fields: [passengerId], references: [id], onDelete: Restrict)
  driver      User     @relation("DriverRatings", fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId])
  @@index([passengerId])
  @@index([rideId])
  @@map("driver_ratings")
}

// -----------------------------------------------------------------------------
// Quick Ride & Publication Idempotency Models
// -----------------------------------------------------------------------------

model IdempotencyKey {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  key          String    @db.VarChar(128)
  targetType   String    @default("RIDE") @map("target_type") @db.VarChar(64)
  requestHash  String    @map("request_hash") @db.VarChar(64)
  rideId       String?   @map("ride_id") @db.Uuid
  responseBody Json      @map("response_body")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ride         Ride?     @relation(fields: [rideId], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@index([userId])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// -----------------------------------------------------------------------------
// Authentication & OTP Verification Models
// -----------------------------------------------------------------------------

model OtpVerification {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email          String   @unique @db.VarChar(255)
  verifierHash   String   @map("verifier_hash") @db.VarChar(128)
  salt           String   @db.VarChar(64)
  failedAttempts Int      @default(0) @map("failed_attempts")
  maxAttempts    Int      @default(5) @map("max_attempts")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  cooldownUntil  DateTime @map("cooldown_until") @db.Timestamptz(6)
  intent         String   @default("signup") @db.VarChar(32)
  fullName       String?  @map("full_name") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email])
  @@index([expiresAt])
  @@map("otp_verifications")
}

// -----------------------------------------------------------------------------
// Milestone 11: Recurring Commutes & Materialization Models
// -----------------------------------------------------------------------------

enum RecurringCommuteStatus {
  ACTIVE
  PAUSED
  CANCELLED

  @@map("recurring_commute_status_type")
}

model RecurringCommute {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driverId             String                 @map("driver_id") @db.Uuid
  audience             Audience
  vehicleId            String                 @map("vehicle_id") @db.Uuid
  origin               String                 @db.VarChar(128)
  originAddress        String?                @map("origin_address") @db.VarChar(255)
  originLatitude       Float?                 @map("origin_latitude")
  originLongitude      Float?                 @map("origin_longitude")
  originPlaceId        String?                @map("origin_place_id") @db.VarChar(128)
  destination          String                 @db.VarChar(128)
  destinationAddress   String?                @map("destination_address") @db.VarChar(255)
  destinationLatitude  Float?                 @map("destination_latitude")
  destinationLongitude Float?                 @map("destination_longitude")
  destinationPlaceId   String?                @map("destination_place_id") @db.VarChar(128)
  pickupDescription    String?                @map("pickup_description") @db.VarChar(255)
  dropoffDescription   String?                @map("dropoff_description") @db.VarChar(255)
  weekdays             Int[]                  @map("weekdays")
  departureTime        String                 @map("departure_time") @db.VarChar(5)
  startDate            DateTime               @map("start_date") @db.Date
  endDate              DateTime               @map("end_date") @db.Date
  availableSeats       Int                    @map("available_seats") @db.Integer
  costPerSeat          Int?                   @map("cost_per_seat") @db.Integer
  status               RecurringCommuteStatus @default(ACTIVE)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  driver               User                   @relation("DriverRecurringCommutes", fields: [driverId, audience], references: [id, audience], onDelete: Restrict)
  vehicle              Vehicle                @relation("VehicleRecurringCommutes", fields: [vehicleId, driverId], references: [id, userId], onDelete: Restrict)
  rides                Ride[]                 @relation("RecurringCommuteRides")
  notifications        Notification[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@map("recurring_commutes")
}

// -----------------------------------------------------------------------------
// Milestone 12: Ride Alerts & In-App Notifications
// -----------------------------------------------------------------------------

enum RideAlertStatus {
  ACTIVE
  PAUSED

  @@map("ride_alert_status_type")
}

model RideAlert {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  audience              Audience
  origin                String          @db.VarChar(128)
  originAddress         String?         @map("origin_address") @db.VarChar(255)
  originLatitude        Float?          @map("origin_latitude")
  originLongitude       Float?          @map("origin_longitude")
  originPlaceId         String?         @map("origin_place_id") @db.VarChar(128)
  destination           String          @db.VarChar(128)
  destinationAddress    String?         @map("destination_address") @db.VarChar(255)
  destinationLatitude   Float?          @map("destination_latitude")
  destinationLongitude  Float?          @map("destination_longitude")
  destinationPlaceId    String?         @map("destination_place_id") @db.VarChar(128)
  radiusKm              Float           @default(3.0) @map("radius_km")
  earliestDepartureTime String?         @map("earliest_departure_time") @db.VarChar(5)
  latestDepartureTime   String?         @map("latest_departure_time") @db.VarChar(5)
  minSeats              Int             @default(1) @map("min_seats") @db.Integer
  status                RideAlertStatus @default(ACTIVE)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User            @relation("UserRideAlerts", fields: [userId, audience], references: [id, audience], onDelete: Cascade)
  notifications         Notification[]  @relation("RideAlertNotifications")

  @@index([userId])
  @@index([audience, status])
  @@map("ride_alerts")
}

enum NotificationType {
  RIDE_MATCH
  BOOKING_REQUESTED
  BOOKING_APPROVED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  RIDE_CANCELLED

  @@map("notification_type")
}

model Notification {
  id                 String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recipientId        String           @map("recipient_id") @db.Uuid
  audience           Audience
  type               NotificationType
  title              String           @db.VarChar(128)
  message            String           @db.VarChar(255)
  rideId             String?          @map("ride_id") @db.Uuid
  bookingId          String?          @map("booking_id") @db.Uuid
  recurringCommuteId String?          @map("recurring_commute_id") @db.Uuid
  rideAlertId        String?          @map("ride_alert_id") @db.Uuid
  isRead             Boolean          @default(false) @map("is_read")
  readAt             DateTime?        @map("read_at") @db.Timestamptz(6)
  dedupKey           String?          @map("dedup_key") @db.VarChar(128)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipient          User             @relation("UserNotifications", fields: [recipientId, audience], references: [id, audience], onDelete: Cascade)
  ride               Ride?            @relation(fields: [rideId], references: [id], onDelete: SetNull)
  booking            Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  recurringCommute   RecurringCommute? @relation(fields: [recurringCommuteId], references: [id], onDelete: SetNull)
  rideAlert          RideAlert?       @relation("RideAlertNotifications", fields: [rideAlertId], references: [id], onDelete: SetNull)

  @@unique([recipientId, dedupKey])
  @@index([recipientId, isRead])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// Milestone 13: Trust, Safety, User Blocking & Incident Reporting
// -----------------------------------------------------------------------------

model Block {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker   User     @relation("UserBlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

enum ReportCategory {
  SAFETY_CONCERN
  HARASSMENT
  NO_SHOW
  FRAUD
  FARE_DISPUTE
  SPAM
  INAPPROPRIATE_BEHAVIOR
  OTHER

  @@map("report_category_type")
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED

  @@map("report_status_type")
}

model Report {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reporterId      String         @map("reporter_id") @db.Uuid
  reportedUserId  String?        @map("reported_user_id") @db.Uuid
  rideId          String?        @map("ride_id") @db.Uuid
  bookingId       String?        @map("booking_id") @db.Uuid
  messageId       String?        @map("message_id") @db.Uuid
  category        ReportCategory
  description     String         @db.VarChar(1000)
  status          ReportStatus   @default(PENDING)
  resolutionNotes String?        @map("resolution_notes") @db.VarChar(1000)
  reviewedBy      String?        @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter        User           @relation("UserReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User?          @relation("UserReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reviewer        User?          @relation("AdminReviewedReports", fields: [reviewedBy], references: [id], onDelete: SetNull)
  ride            Ride?          @relation("ReportedRides", fields: [rideId], references: [id], onDelete: SetNull)
  booking         Booking?       @relation("ReportedBookings", fields: [bookingId], references: [id], onDelete: SetNull)
  message         Message?       @relation("ReportedMessages", fields: [messageId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("reports")
}



