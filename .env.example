# ==============================================================================
# VIT Chennai Carpooling Platform — Environment Configuration Template
# Copy this file to .env for local development. Never commit .env to source control.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL & PostGIS Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Port 5433 avoids conflict with any local Homebrew PostgreSQL instances on 5432
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=vit_carpool_dev

# Primary Development Database URL (used by NestJS API and Prisma Client)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/vit_carpool_dev?schema=public

# Shadow Database URL (used exclusively by Prisma Migrate for safe schema diffing)
SHADOW_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/vit_carpool_shadow?schema=public

# Test Database URL (isolated for automated integration and e2e test suites)
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/vit_carpool_test?schema=public

# ------------------------------------------------------------------------------
# Backend NestJS API Configuration
# ------------------------------------------------------------------------------
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Vite Web Application Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Configurable Institutional Email Patterns (Milestone 2)
# ------------------------------------------------------------------------------
# Patterns will be finalized upon confirmation of exact campus email formats.
STUDENT_EMAIL_REGEX=^[a-zA-Z0-9._%+-]+@vitstudent\.ac\.in$
FACULTY_EMAIL_REGEX=^[a-zA-Z0-9._%+-]+@vit\.ac\.in$

# ------------------------------------------------------------------------------
# Supabase Authentication (Milestone 2 legacy fallback)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# Custom RS256 JWT Session Authentication (Production Key Pair)
# Base64-encoded or PEM string format. Required in production.
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# ------------------------------------------------------------------------------
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=vit-carpool-jwt-key-1
JWT_ISSUER=https://api.vitcarpool.app/auth/v1
# Public JWKS endpoints: https://api.vitcarpool.app/auth/v1/.well-known/jwks.json (and /auth/.well-known/jwks.json)
JWT_AUDIENCE=authenticated

# Keyed HMAC Secret for OTP Verification Verifier Storage (at least 32 characters in production)
OTP_HMAC_SECRET=

# Periodic OTP Cleanup Interval in milliseconds (default: 30 minutes = 1800000)
OTP_CLEANUP_INTERVAL_MS=1800000

# ------------------------------------------------------------------------------
# Nodemailer / Gmail SMTP Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VIT Carpool <vitcarpool.app@gmail.com>"

# Authentication IP Rate Limiting (Requests per Window)
# Process-local memory rate limiting. When deployed behind a reverse proxy (e.g., Nginx, ALB, Cloudflare),
# configure TRUST_PROXY (e.g., "1", "true", or trusted CIDR) so Express extracts the true client IP from proxy hops.
# If multiple API instances are deployed, rate limits are enforced per node unless configured with upstream WAF.
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_LIMIT=10
TRUST_PROXY=

